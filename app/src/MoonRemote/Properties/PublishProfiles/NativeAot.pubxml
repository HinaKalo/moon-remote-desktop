<?xml version="1.0" encoding="utf-8"?>
<!--
  Ahead-of-time compiled native executable: fastest start-up, no JIT, nothing to install.
  Requires the platform C/C++ toolchain (Windows: VS Build Tools "Desktop development with C++").
  Cannot cross-compile to another OS. Skia / HarfBuzz native libraries ship next to the .exe.
  dotnet publish -c Release -p:PublishProfile=NativeAot
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">$(NETCoreSdkRuntimeIdentifier)</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishAot>true</PublishAot>
    <OptimizationPreference>Size</OptimizationPreference>
    <StripSymbols>true</StripSymbols>
    <DebugType>none</DebugType>

    <DebuggerSupport>false</DebuggerSupport>
    <EventSourceSupport>false</EventSourceSupport>
    <MetricsSupport>false</MetricsSupport>
    <HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>
    <EnableUnsafeBinaryFormatterSerialization>false</EnableUnsafeBinaryFormatterSerialization>
    <SatelliteResourceLanguages>en;zh-Hans</SatelliteResourceLanguages>

    <PublishDir>$(MSBuildProjectDirectory)\bin\publish\native-aot\</PublishDir>
  </PropertyGroup>
</Project>
