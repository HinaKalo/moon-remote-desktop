<?xml version="1.0" encoding="utf-8"?>
<!--
  Smallest download. Single .exe that needs the .NET 10 runtime installed on the target machine.
  dotnet publish -c Release -p:PublishProfile=FrameworkDependent
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">$(NETCoreSdkRuntimeIdentifier)</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
    <PublishDir>$(MSBuildProjectDirectory)\bin\publish\framework-dependent\</PublishDir>
  </PropertyGroup>
</Project>
