<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="https://github.com/HinaKalo/lumen"
             xmlns:vm="using:MoonRemote.ViewModels"
             x:Class="MoonRemote.Views.HomePage"
             x:DataType="vm:HomePageViewModel">
  <ScrollViewer>
    <StackPanel Classes="page">
      <l:SectionHeader Title="Welcome"
                       Description="This page is a starting point — replace it with your own content." />

      <UniformGrid Columns="3" Margin="-8,0">
        <l:StatCard Margin="8" Label="Clicks" Value="{Binding Clicks}" Icon="MousePointer" Caption="this session" />
        <l:StatCard Margin="8" Label="Theme" Value="Lumen" Icon="Droplet" Caption="light · dark · accent" />
        <l:StatCard Margin="8" Label="Status" Value="Ready" Icon="CircleCheck" Delta="OK" Trend="Up" />
      </UniformGrid>

      <l:Card Header="Say hello" Description="A tiny MVVM example: two-way binding, commands, toast and dialog.">
        <StackPanel Spacing="14" Margin="0,8,0,0" MaxWidth="420" HorizontalAlignment="Left">
          <l:FormField Label="Your name" Hint="Press Enter or click Greet.">
            <TextBox Text="{Binding Name}" PlaceholderText="Ada Lovelace" />
          </l:FormField>
        </StackPanel>
        <l:Card.Footer>
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Classes="ghost" Content="Reset" Command="{Binding ResetCommand}" />
            <Button Classes="primary" Content="Greet" IsDefault="True" Command="{Binding GreetCommand}" />
          </StackPanel>
        </l:Card.Footer>
      </l:Card>
    </StackPanel>
  </ScrollViewer>
</UserControl>
