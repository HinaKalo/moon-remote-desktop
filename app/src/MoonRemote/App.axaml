<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="https://github.com/HinaKalo/lumen"
             x:Class="MoonRemote.App"
             RequestedThemeVariant="Default">
  <Application.Styles>
    <l:LumenTheme />

    <!-- App-wide page layout -->
    <Style Selector="StackPanel.page">
      <Setter Property="Margin" Value="32,28,32,40" />
      <Setter Property="Spacing" Value="24" />
      <Setter Property="MaxWidth" Value="1100" />
    </Style>
  </Application.Styles>
</Application>
