# moon-remote-server production environment (systemd EnvironmentFile).
# Secrets are never inline: every *_FILE points to a 0600 file owned by the service user.
# Generate key files with: moon-remote-server keygen > /etc/moon-remote/master.key  (and roster.key)

MRD_LISTEN=127.0.0.1:8621
MRD_PUBLIC_URL=https://remote.moonl.cloud
MRD_SSO_ISSUER=https://sso.moonl.cloud

# OAuth clients registered on sso.moonl.cloud on 2026-11-20 (public clients, subject_type=public,
# require_dpop, first_party, skip_consent). Client ids are not secrets.
#   ms_PTyfu8NoBmsYspSFmqdu  Moon Remote Desktop  native  redirect http://127.0.0.1/callback (any port)
#   ms_bZjB-HZgyTyylUAWQ8il  Moon Remote Web      web     redirect https://remote.moonl.cloud/auth/callback
MRD_SSO_CLIENT_IDS=ms_PTyfu8NoBmsYspSFmqdu,ms_bZjB-HZgyTyylUAWQ8il

MRD_DSN_FILE=/etc/moon-remote/db.dsn
MRD_MASTER_KEY_FILE=/etc/moon-remote/master.key
MRD_ROSTER_KEY_FILE=/etc/moon-remote/roster.key

# EasyTier server nodes (pinned v2.7.1, linux x86_64). One node and one public port per account
# network; open this port range for TCP and UDP in the firewall.
MRD_ET_CORE=/opt/moon-remote/easytier/easytier-core
MRD_ET_CLI=/opt/moon-remote/easytier/easytier-cli
MRD_ET_DATA_DIR=/var/lib/moon-remote/et
MRD_ET_PUBLIC_HOST=remote.moonl.cloud
MRD_ET_PORTS=21000-21999

# coturn (static-auth-secret); leave both unset to disable TURN.
# MRD_TURN_SECRET_FILE=/etc/moon-remote/turn.secret
# MRD_TURN_URLS=turns:turn.remote.moonl.cloud:443?transport=tcp,turn:turn.remote.moonl.cloud:3478?transport=udp
# MRD_STUN_URLS=stun:turn.remote.moonl.cloud:3478
